# Copy to .env (never commit .env). Horizon reads provider keys the same way the hud CLI does:
# process env, then ./.env, then ~/.hud/.env. Keys set with `hud set KEY=value` already work.

# At least one model provider. Horizon never displays key values, only whether one is present.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: local models through any OpenAI-compatible server (Ollama, LM Studio).
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional: HUD platform key. Only needed to sync traces to hud.ai. Note: if this is set and no
# provider key is, the hud SDK routes inference through HUD's gateway (which needs credits).
HUD_API_KEY=

# Horizon runs fully offline by default (no telemetry upload, no platform calls).
HUD_TELEMETRY_ENABLED=false

# Server
HORIZON_DB_PATH=../data/horizon.db
HORIZON_ALLOWED_ORIGINS=http://localhost:3000

# App
NEXT_PUBLIC_API_URL=http://localhost:8000
